{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.trimTrailingWhitespace": true,
    "files.eol": "\n",
    "[jsonc]": {
      "editor.formatOnSave": true,
      "editor.tabSize": 2,
      "editor.defaultFormatter": "vscode.json-language-features",
      // When opening a file, `editor.tabSize` and `editor.insertSpaces`
      // will be detected based on the file contents. Set to false to keep
      // the values you've explicitly set, above.
      // https://stackoverflow.com/a/29972553
      "editor.detectIndentation": false
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python Debugger: Print help",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "console": "integratedTerminal",
        "args": [
          "-h"
        ]
      },
      {
        "name": "Python Debugger: No arguments",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "console": "integratedTerminal",
        "args": [
          "--omit-time",
          "--verbose"
        ]
      },
      {
        "name": "Python Debugger: Low Profile mode",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "console": "integratedTerminal",
        "args": [
          "--omit-time",
          "--verbose",
          "--lowprofile"
        ]
      },
      {
        "name": "Python Debugger: US only",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "console": "integratedTerminal",
        "args": [
          "--omit-time",
          "--verbose",
          "--country",
          "United States"
        ]
      },
      {
        "name": "Python Debugger: CZ only",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "console": "integratedTerminal",
        "args": [
          "--omit-time",
          "--verbose",
          "--country",
          "Czechia"
        ]
      },
