{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Print help",
      "type": "debugpy",
      "request": "launch",
      "program": "cli.py",
      "console": "integratedTerminal",
      "args": [
        "-h"
      ]
    },
    {
      "name": "Python Debugger: No arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "cli.py",
      "console": "integratedTerminal",
      "args": [
        "--omit-time",
        "--verbose"
      ]
    },
    {
      "name": "Python Debugger: Low Profile mode",
      "type": "debugpy",
      "request": "launch",
      "program": "cli.py",
      "console": "integratedTerminal",
      "args": [
        "--omit-time",
        "--verbose",
        "--lowprofile"
      ]
    },
